<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>База Рецептов Сыровяленых и Сырокопченых Колбас</title>
    <style>
        :root {
            --bg: #121212;
            --surface: #1e1e1e;
            --surface-card: #252525;
            --primary: #ff5722;
            --text: #e0e0e0;
            --text-muted: #a0a0a0;
            --border: #333333;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid var(--primary);
            padding-bottom: 15px;
        }

        h1 {
            color: var(--primary);
            margin: 0 0 10px 0;
            font-size: 2rem;
        }

        p.subtitle {
            color: var(--text-muted);
            margin: 0;
        }

        .calculator-global {
            background-color: var(--surface);
            padding: 20px;
            border-radius: 10px;
            border: 1px solid var(--border);
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .calculator-global label {
            font-weight: bold;
            font-size: 1.1rem;
        }

        .calculator-global input {
            background: #2c2c2c;
            border: 1px solid var(--primary);
            color: #fff;
            padding: 10px 15px;
            border-radius: 6px;
            font-size: 1.1rem;
            width: 120px;
        }

        .recipes-grid {
            display: grid;
            gap: 20px;
        }

        .recipe-card {
            background-color: var(--surface-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            transition: transform 0.2s;
        }

        .recipe-card:hover {
            border-color: var(--primary);
        }

        .recipe-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            padding-bottom: 10px;
            margin-bottom: 15px;
        }

        .recipe-title {
            margin: 0;
            color: var(--primary);
            font-size: 1.4rem;
        }

        .tag {
            background: #333;
            color: var(--text-muted);
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.85rem;
        }

        .tag.kopchenie {
            background: #4a2c00;
            color: #ffb74d;
        }

        .tag.vyalenie {
            background: #1b3a1e;
            color: #81c784;
        }

        .section-title {
            font-weight: bold;
            margin-top: 15px;
            margin-bottom: 8px;
            color: #fff;
            text-decoration: underline;
        }

        ul {
            margin: 0;
            padding-left: 20px;
        }

        li {
            margin-bottom: 5px;
        }

        .val {
            color: var(--primary);
            font-weight: bold;
        }

        .tech-steps {
            background-color: #1a1a1a;
            padding: 12px;
            border-radius: 6px;
            font-size: 0.95rem;
            line-height: 1.5;
            margin-top: 10px;
        }

        @media (max-width: 600px) {
            body { padding: 10px; }
            .calculator-global { flex-direction: column; align-items: flex-start; }
            .recipe-header { flex-direction: column; align-items: flex-start; gap: 5px; }
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>База Рецептов Колбас</h1>
        <p class="subtitle">Интерактивный справочник сыровяленых и сырокопченых колбас</p>
    </header>

    <div class="calculator-global">
        <label for="weightInput">Вес парти (кг):</label>
        <input type="number" id="weightInput" value="1" min="0.1" step="0.1" oninput="recalculate()">
        <span>Укажите нужный вес фарша — специи и мясной состав пересчитаются автоматически.</span>
    </div>

    <div class="recipes-grid" id="recipesContainer"></div>
</div>

<script>
const recipes = [
    {
        id: "milano",
        name: "1. Салями «Милано»",
        type: "vyalenie",
        typeText: "Сыровяленая (Без копчения)",
        meat: [
            { name: "Свинина полужирная (лопатка/окорок)", base: 700, unit: "г" },
            { name: "Шпик хребтовый твердый", base: 300, unit: "г" }
        ],
        spices: [
            { name: "Соль нитритная (0.5-0.6%)", base: 28, unit: "г" },
            { name: "Сахар или декстроза", base: 4, unit: "г" },
            { name: "Перец белый молотый", base: 2, unit: "г" },
            { name: "Чеснок сушеный", base: 1.5, unit: "г" },
            { name: "Вино сухое белое (холодное)", base: 20, unit: "мл" }
        ],
        tech: "Мясо и шпик подморозить (-1..-2°C) и измельчить через решетку 3-4 мм. Вымешать с солью, специями и вином до липкости. Набить в оболочку калибра 50-60 мм. Вялить при +12..+14°C и влажности 75-78% до усушки 30-35%."
    },
    {
        id: "chorizo",
        name: "2. Чоризо",
        type: "vyalenie",
        typeText: "Сыровяленая (Без копчения)",
        meat: [
            { name: "Свинина нежирная", base: 600, unit: "г" },
            { name: "Свиная грудинка / шпик", base: 400, unit: "г" }
        ],
        spices: [
            { name: "Соль нитритная (0.5-0.6%)", base: 28, unit: "г" },
            { name: "Паприка копченая (или сладкая)", base: 18, unit: "г" },
            { name: "Перец красный острый (чили)", base: 2.5, unit: "г" },
            { name: "Чеснок свежий (давленный) или сухой", base: 3, unit: "г" },
            { name: "Орегано сушеный", base: 1, unit: "г" },
            { name: "Сахар / декстроза", base: 3, unit: "г" }
        ],
        tech: "Измельчить мясо и жир через крупную решетку (6-8 мм) для рубленной структуры. Тщательно вымешать со специями. Набить в свиную череву 38-42 мм или коллаген. Вялить до усушки 30-35%."
    },
    {
        id: "felino",
        name: "3. Салями «Фелино»",
        type: "vyalenie",
        typeText: "Сыровяленая (Без копчения)",
        meat: [
            { name: "Свинина нежирная (окорок)", base: 750, unit: "г" },
            { name: "Шпик твердый хребтовый", base: 250, unit: "г" }
        ],
        spices: [
            { name: "Соль нитритная (0.5-0.6%)", base: 28, unit: "г" },
            { name: "Перец черный горошком (цельный)", base: 3, unit: "г" },
            { name: "Чеснок (настоять в 20мл вина, влить вино)", base: 1.5, unit: "г" },
            { name: "Сахар / декстроза", base: 3, unit: "г" }
        ],
        tech: "Мясо пропустить через решетку 6 мм, шпик нарезать кубиком 4-5 мм. Влить чесночное вино, всыпать цельный перец, соль и сахар. Вымешать, забить в оболочку 45-50 мм. Вялить до усушки 30-35%."
    },
    {
        id: "sudzhuk",
        name: "4. Домашний Суджук",
        type: "vyalenie",
        typeText: "Сыровяленая (Без копчения)",
        meat: [
            { name: "Говядина нежирная (или баранина)", base: 800, unit: "г" },
            { name: "Жир говяжий или свиной", base: 200, unit: "г" }
        ],
        spices: [
            { name: "Соль нитритная (0.5-0.6%)", base: 28, unit: "г" },
            { name: "Чабер (кондари) или базилик", base: 3, unit: "г" },
            { name: "Кориандр молотый", base: 2, unit: "г" },
            { name: "Зира (тмин) молотая", base: 2, unit: "г" },
            { name: "Перец черный молотый", base: 2, unit: "г" },
            { name: "Перец красный острый", base: 1, unit: "г" },
            { name: "Сахар", base: 3, unit: "г" }
        ],
        tech: "Пропустить через решетку 4-5 мм, вымешать, набить в говяжьи черевы. За время сушки 3-4 раза прокатывать скалкой для придания плоской формы."
    },
    {
        id: "egerskie",
        name: "5. Егерские колбаски",
        type: "kopchenie",
        typeText: "Сырокопченая",
        meat: [
            { name: "Свинина полужирная", base: 500, unit: "г" },
            { name: "Говядина нежирная", base: 300, unit: "г" },
            { name: "Грудинка свиная жирная", base: 200, unit: "г" }
        ],
        spices: [
            { name: "Соль нитритная (0.5-0.6%)", base: 28, unit: "г" },
            { name: "Перец черный молотый", base: 2, unit: "г" },
            { name: "Тмин молотый", base: 1.5, unit: "г" },
            { name: "Чеснок сушеный", base: 2, unit: "г" },
            { name: "Кориандр молотый", base: 1, unit: "г" },
            { name: "Сахар / декстроза", base: 4, unit: "г" }
        ],
        tech: "Решетка 4-5 мм. Набивка в свиную или баранью череву (32-36 мм). Осадка 24-48 часов при +2..+4°C. Холодное копчение (+18..+20°C) 18-24 часа. Досушивание до усушки 30-35%."
    },
    {
        id: "pepperoni",
        name: "6. Пепперони",
        type: "kopchenie",
        typeText: "Сырокопченая",
        meat: [
            { name: "Свинина полужирная", base: 500, unit: "г" },
            { name: "Говядина нежирная", base: 300, unit: "г" },
            { name: "Шпик / грудинка", base: 200, unit: "г" }
        ],
        spices: [
            { name: "Соль нитритная (0.5-0.6%)", base: 28, unit: "г" },
            { name: "Паприка молотая", base: 10, unit: "г" },
            { name: "Перец чили / кайенский", base: 3, unit: "г" },
            { name: "Анис или фенхель молотый", base: 1, unit: "г" },
            { name: "Чеснок сушеный", base: 2, unit: "г" },
            { name: "Сахар / декстроза", base: 5, unit: "г" }
        ],
        tech: "Решетка 3-4 мм. Набивка в калибр 38-42 мм. Осадка 24 часа. Холодное копчение 24 часа. Вяление до усушки 35%."
    },
    {
        id: "knuty",
        name: "7. Охотничьи колбаски (Кнуты)",
        type: "kopchenie",
        typeText: "Сырокопченая",
        meat: [
            { name: "Свинина нежирная", base: 600, unit: "г" },
            { name: "Грудинка свиная жирная", base: 400, unit: "г" }
        ],
        spices: [
            { name: "Соль нитритная (0.5-0.6%)", base: 28, unit: "г" },
            { name: "Перец черный молотый", base: 2, unit: "г" },
            { name: "Перец душистый молотый", base: 1, unit: "г" },
            { name: "Чеснок сушеный", base: 2, unit: "г" },
            { name: "Сахар / декстроза", base: 4, unit: "г" }
        ],
        tech: "Решетка 4 мм. Набивка в баранью череву (20-24 мм) или тонкий коллаген. Осадка 12-24 часа, холодное копчение 8-12 часов, сушка 5-7 дней."
    }
];

function recalculate() {
    const weight = parseFloat(document.getElementById('weightInput').value) || 1;
    const container = document.getElementById('recipesContainer');
    container.innerHTML = '';

    recipes.forEach(r => {
        let card = document.createElement('div');
        card.className = 'recipe-card';

        let meatHtml = r.meat.map(m => {
            let val = (m.base * weight).toFixed(1);
            return `<li>${m.name}: <span class="val">${val} ${m.unit}</span></li>`;
        }).join('');

        let spicesHtml = r.spices.map(s => {
            let val = (s.base * weight).toFixed(1);
            return `<li>${s.name}: <span class="val">${val} ${s.unit}</span></li>`;
        }).join('');

        card.innerHTML = `
            <div class="recipe-header">
                <h2 class="recipe-title">${r.name}</h2>
                <span class="tag ${r.type}">${r.typeText}</span>
            </div>
            <div class="section-title">Состав сырья:</div>
            <ul>${meatHtml}</ul>
            <div class="section-title">Специи и добавки:</div>
            <ul>${spicesHtml}</ul>
            <div class="section-title">Технология:</div>
            <div class="tech-steps">${r.tech}</div>
        `;

        container.appendChild(card);
    });
}

// Первоначальный вызов
recalculate();
</script>

</body>
</html>
